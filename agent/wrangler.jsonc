{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gate-check",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "observability": {"enabled": true},
  "ai": {"binding": "AI"},
  // Protects the model allowance: at most 6 questions per minute per visitor.
  "ratelimits": [{"name": "LIMITER", "namespace_id": "1001", "simple": {"limit": 6, "period": 60}}],
  // Finished answers, keyed by model and question, kept for 30 days.
  "kv_namespaces": [{"binding": "ANSWERS", "id": "f58f7fffd1bd4fc6a4e4ed161801f0f8"}],
  "vars": {
    "KB_MCP_URL": "https://api.sanity.io/v1/context/organizations/odt24larb/mcp/gate-check-rules",
    "DATA_MCP_URL": "https://api.sanity.io/v1/context/organizations/odt24larb/mcp/gate-check-data",
    // The agent runs on Workers AI. The ChatGPT-plan relay (relay/plan-relay.mjs) ran only
    // during the challenge; setting PLAN_MODEL, PLAN_RELAY_URL and PLAN_RELAY_KEY again brings it back.
    "MODEL": "@cf/nvidia/nemotron-3-120b-a12b"
  }
  // Secrets: SANITY_CONTEXT_TOKEN
}
